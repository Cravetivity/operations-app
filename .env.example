# Copy to .env and fill in. Every config knob lives here (see CLAUDE.md).

# --- App ---
APP_PORT=8000                 # host port docker compose publishes
POSTGRES_PASSWORD=ops         # postgres password (compose wires DATABASE_URL)
DISPLAY_TIMEZONE=America/Chicago

# --- Local development outside Docker only ---
# DATABASE_URL=postgresql+asyncpg://ops:ops@localhost:5432/ops

# --- BamBuddy (external instance; see docs/integrations.md) ---
BAMBUDDY_URL=                 # e.g. http://bambuddy.lan:8080
BAMBUDDY_API_KEY=             # dedicated "operations-app" API key

# --- Spoolman (external instance) ---
SPOOLMAN_URL=                 # e.g. http://spoolman.lan:7912

# --- Order polling ---
ORDER_POLL_SECONDS=300

# --- Etsy (Phase 2; OAuth2) ---
ETSY_API_KEY=

# --- eBay (Phase 2; OAuth2) ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# --- Shopify (Phase 2; custom-app admin token) ---
SHOPIFY_STORE=                # e.g. cravetivity (for cravetivity.myshopify.com)
SHOPIFY_ACCESS_TOKEN=
