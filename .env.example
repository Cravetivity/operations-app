# Copy to .env and fill in. Every config knob lives here (see CLAUDE.md).

# --- App ---
APP_PORT=8000                 # host port docker compose publishes
POSTGRES_PASSWORD=ops         # postgres password (compose wires DATABASE_URL)
DISPLAY_TIMEZONE=America/Chicago

# --- Local development outside Docker only ---
# DATABASE_URL=postgresql+asyncpg://ops:ops@localhost:5432/ops

# --- BamBuddy (see docs/integrations.md) ---
# Real instance: http://bambuddy.lan:8080 + its API key.
# Dev harness (docker compose --profile dev up): the mock printer farm.
BAMBUDDY_URL=http://mock-bambuddy:8000
BAMBUDDY_API_KEY=test-key     # dedicated "operations-app" API key on the real instance

# --- Spoolman ---
# Compose runs a real Spoolman at http://spoolman:8000 (host: localhost:7912)
# and wires SPOOLMAN_URL to it by default; only set this to point elsewhere.
# SPOOLMAN_URL=http://spoolman.lan:7912
SPOOLMAN_PORT=7912            # host port for the bundled Spoolman UI/API
SPOOL_LOW_STOCK_GRAMS=150
PRINTER_POLL_SECONDS=3

# --- Order polling ---
ORDER_POLL_SECONDS=300

# --- Etsy (Phase 2; OAuth2) ---
ETSY_API_KEY=

# --- eBay (Phase 2; OAuth2) ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# --- Shopify (Phase 2; custom-app admin token) ---
SHOPIFY_STORE=                # e.g. cravetivity (for cravetivity.myshopify.com)
SHOPIFY_ACCESS_TOKEN=
